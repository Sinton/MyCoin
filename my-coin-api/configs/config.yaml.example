app:
  port: 8080
  mode: "debug" # debug, release

database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "your_password"
  dbname: "my_coin"
  sslmode: "disable"

jwt:
  secret: "your_jwt_secret_key_change_me"
  access_timeout: "2h"
  refresh_timeout: "720h" # 30 days

# Apple App Store Server API Configuration
apple:
  bundle_id: "com.yourcompany.mycoin"
  issuer_id: "your_apple_issuer_id"
  key_id: "your_apple_key_id"
  private_key_path: "configs/apple_private_key.p8"
  environment: "sandbox" # sandbox, production
